<View>
  <Header value="Независимая оценка резюме и вакансии" />
  <Text name="review_meta" value="$review_id" />
  <Header value="Дата для расчёта текущего опыта" />
  <Text name="reference_date" value="$reference_date" />
  <Text name="instructions" value="Прочитайте оба текста. Самостоятельно выделите в вакансии каждое проверяемое требование и выберите его категорию. Для выделенного требования укажите название, балл, объяснение и точную цитату из резюме. Оценки другого участника и модели здесь отсутствуют. В конце выставьте отдельную общую оценку и сохраните ответ." />
  <Header value="Ваш идентификатор участника" />
  <TextArea name="reviewer_id" toName="requirements" editable="true" rows="1" maxSubmissions="1" required="true" />
  <View style="display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start;margin-top:16px;">
    <View style="flex:1;min-width:280px;">
      <Header value="Резюме" />
      <View style="max-height:500px;overflow-y:auto;padding:10px;background:#f7f9fc;">
        <Text name="cv" value="$cv_text" />
      </View>
    </View>
    <View style="flex:1;min-width:280px;">
      <Header value="Вакансия" />
      <Labels name="requirement_type" toName="requirements">
        <Label value="ROLE_LEVEL" background="#b8a1f2" />
        <Label value="EXPERIENCE" background="#ffc078" />
        <Label value="HARD_SKILL" background="#8ce99a" />
        <Label value="SOFT_SKILL" background="#91d5ff" />
        <Label value="EDUCATION" background="#eebefa" />
        <Label value="LANGUAGE" background="#ffa8a8" />
        <Label value="OTHER" background="#ced4da" />
      </Labels>
      <View style="max-height:500px;overflow-y:auto;padding:10px;background:#f7f9fc;">
        <Text name="requirements" value="$vacancy_display" />
      </View>
    </View>
  </View>
  <Text name="rubric" value="Требование: 0 — недостаточно сведений; 1 — подтверждённое несоответствие; 2 — частичное соответствие; 3 — соответствие. Для 0 цитата резюме пустая; для 1–3 нужна точная непустая цитата. Отсутствие слова не доказывает отсутствие навыка." />
  <View visibleWhen="region-selected">
    <Header value="Выделенное требование" />
    <TextArea name="requirement_title" toName="requirements" perRegion="true" editable="true" rows="2" maxSubmissions="1" required="true" />
    <Choices name="match_score" toName="requirements" perRegion="true" choice="single-radio" showInline="true" required="true">
      <Choice value="0" /><Choice value="1" /><Choice value="2" /><Choice value="3" />
    </Choices>
    <Header value="Объяснение оценки требования" />
    <TextArea name="reason" toName="requirements" perRegion="true" editable="true" rows="3" maxSubmissions="1" required="true" />
    <Header value="Точная цитата из резюме" />
    <TextArea name="cv_evidence" toName="requirements" perRegion="true" editable="true" rows="3" maxSubmissions="1" />
  </View>
  <Header value="Общая оценка пары" />
  <Text name="overall_rubric" value="0 — недостаточно данных; 1 — слабое соответствие; 2 — частичное соответствие; 3 — хорошее соответствие. Это отдельное суждение, не среднее баллов. Общая 0 требует неизвестного требования; все неизвестные требования означают общую 0. Подтверждённое несоответствие роли или уровня не допускает общую 3." />
  <Choices name="overall_score" toName="requirements" choice="single-radio" showInline="true" required="true">
    <Choice value="0" /><Choice value="1" /><Choice value="2" /><Choice value="3" />
  </Choices>
  <TextArea name="overall_reason" toName="requirements" editable="true" rows="4" maxSubmissions="1" required="true" />
  <Header value="Замечания о качестве текста или спорных сведениях" />
  <TextArea name="review_notes" toName="requirements" editable="true" rows="3" maxSubmissions="1" />
  <Choices name="human_review" toName="requirements" choice="multiple" required="true">
    <Choice value="Я проверил требования, баллы и общую оценку" />
  </Choices>
</View>
