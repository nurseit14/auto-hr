  "narrative": {
    "northStar": "The Recruitment Dispatch Desk",
    "overview": "The Recruitment Dispatch Desk pairs a stable ink-navy frame with cool light reading surfaces. Compact controls and strong Cyrillic headings support repeated scanning; evidence, unknowns, and explicit human decisions carry the visual emphasis.\n\nThe system is restrained and operational. Manrope supplies both headings and body text, white panels separate work from the cooler canvas, and small status tags communicate professional evidence without turning the interface into a field of saturated cards.",
    "keyCharacteristics": [
      "Stable navy navigation with light reading surfaces.",
      "One neutral Cyrillic type family with a compact hierarchy.",
      "Cobalt actions; green confirmed evidence; amber unknowns.",
      "Flat panels and explicit responsive navigation."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Use green for confirmed evidence and amber for information that needs clarification; keep the meaning visible in text.",
        "section": "colors"
      },
      {
        "name": "The Single Family Rule",
        "body": "Use Manrope across headings, labels, and reading text; use weight and size to establish hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Flat Workbench Rule",
        "body": "Separate everyday panels with tone and thin borders; reserve the substantial shadow for dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep confirmed coverage separate from relative ranking values.",
      "Do preserve visible keyboard focus and text labels alongside status color.",
      "Do retain the explicit back path when mobile shows an individual dossier.",
      "Do use SVG line icons and the shipped geometric brand mark."
    ],
    "donts": [
      "Don't substitute a condensed display face for the neutral Cyrillic hierarchy.",
      "Don't use green and amber as interchangeable decorative accents.",
      "Don't extend dialog shadows to every workbench panel.",
      "Don't replace inspectable evidence with an unexplained score."
    ]
  }
}
